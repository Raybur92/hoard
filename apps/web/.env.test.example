# E2E test environment — Playwright reads this when running against the
# dedicated `hoard-test` Supabase project. The real `apps/web/.env.test`
# is gitignored; copy this file to `.env.test` and fill in real values.
#
# Connection string source: Supabase dashboard → hoard-test project →
# Project Settings → Database → Connection string → Transaction pooler
# (port 6543). Append the prod-matching query params per CLAUDE.md
# operational gotchas: ?pgbouncer=true&connection_limit=5
#
# DO NOT use the Direct connection (port 5432) here — that is for
# migration replay only, not the runtime API used by E2E.

DATABASE_URL_TEST=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5
