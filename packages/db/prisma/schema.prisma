// Hoard — Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameStatus {
  Playing
  Backlog
  Completed
  OnHold
  Dropped
  Wishlist
}

enum PlatformCode {
  ST
  PS
  XB
  GG
  NT
  EP
}

enum SyncStatus {
  ok
  syncing
  error
  stale
  manual
}

enum SyncFrequency {
  FIVE_MIN
  FIFTEEN_MIN
  HOURLY
  MANUAL
}

enum LogLevel {
  info
  warn
  error
}

enum UserStatus {
  PENDING_INVITE
  ACTIVE
}

// F1-PR2 collector-metadata enums per CONCEPTUAL_MODEL CM2 + the
// simplification locked 2026-05-22.
//
// MediaType — UserGame.mediaType. DIGITAL = bought/downloaded digitally;
// PHYSICAL = have a physical copy (disc/cart/cardboard — the specific form
// is inferable from the platform code: PS5 = disc, SNES = cart, etc.).
// Simplified from a 4-value enum (PHYSICAL_DISC/PHYSICAL_CART/ROM/DIGITAL_KEY)
// because the platform tells you the physical form; mediaType only needs
// to differentiate digital from physical.
enum MediaType {
  DIGITAL
  PHYSICAL
}

// Condition — UserGame.condition (and shared with MarketplaceListing.condition
// per CONCEPTUAL_MODEL §3.19 + §6.3). Optional on UserGame for physical
// collection metadata.
enum Condition {
  LOOSE
  CIB
  SEALED
  REPLICA
  GRADED
}

// Region — UserGame.region (and shared with MarketplaceListing.region). Optional
// for physical/retro entries where region matters (PAL SNES carts won't
// accept NTSC carts unmodded, etc.).
enum Region {
  NTSC_U
  NTSC_J
  PAL
  OTHER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  googleId  String?  @unique
  steamId   String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Closed-beta gating (docs/INVITE_CODES_PLAN.md). New signups land in
  // PENDING_INVITE; redemption flips to ACTIVE. isAdmin gates the /admin
  // surface (one row only — Andrea — for v1; column instead of env var
  // per I-D4 so the bit survives DB rebuilds). hasRequestedAccess +
  // accessRequestMessage + accessRequestedAt back the welcome screen's
  // "request access" path; the flag is append-only (stays true after
  // redemption per I-D12a, gives admin context).
  status               UserStatus @default(PENDING_INVITE)
  isAdmin              Boolean    @default(false)
  hasRequestedAccess   Boolean    @default(false)
  accessRequestMessage String?
  accessRequestedAt    DateTime?

  // preferences
  hypeThreshold  Int     @default(5)
  libraryView    String  @default("shelves")
  showHltb       Boolean @default(true)
  coverDensity   String  @default("standard")
  terminalCursor Boolean @default(true)

  platforms          Platform[]
  userGames          UserGame[]
  wishlists          WishlistRelease[]
  redeemedInviteCode InviteCode?
  feedback           Feedback[]
  events             UserEvent[]
}

// Closed-beta access codes (docs/INVITE_CODES_PLAN.md). Format
// HOARD-XXXX-XXXX from the 32-char alphabet ABCDEFGHJKLMNPQRSTUVWXYZ23456789
// (no 0/O/1/I — typed by hand, ambiguity matters). Single-use:
// usedById is @unique so a code maps 1:1 to the user who redeemed it.
// Generated server-side via /api/admin/invite-codes; redeemed via
// /api/auth/redeem-invite (atomic update with WHERE usedById IS NULL
// predicate per I-D10 to make the redemption race-safe).
model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  note      String?
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  usedById  String?   @unique
  // onDelete: SetNull is what the live SQL already does (the I1 migration
  // hand-wrote `ON DELETE SET NULL` on this FK; per A-D3 in
  // docs/ADMIN_POLISH_PLAN.md, this annotation makes the same behaviour
  // explicit at the schema layer instead of relying on Prisma's implicit
  // default for optional relations — futureproofs against a Prisma
  // version that ever changes that default. Verified zero SQL diff via
  // `prisma migrate diff --to-url $DATABASE_URL` before commit landed.
  usedBy    User?     @relation(fields: [usedById], references: [id], onDelete: SetNull)
}

model Platform {
  id            String        @id @default(cuid())
  userId        String
  code          PlatformCode
  credentials   Json?
  syncable      Boolean       @default(true)
  lastSyncAt    DateTime?
  syncStatus    SyncStatus    @default(manual)
  syncFrequency SyncFrequency @default(HOURLY)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs PlatformLog[]

  @@unique([userId, code])
}

// PR B of the settings audit workstream (`docs/SETTINGS_AUDIT_PLAN.md`).
// Per-platform activity feed: every sync touchpoint emits one or more
// log entries that the client surfaces on PlatformDetail's Log tab in
// terminal aesthetic. Aggregates only — per-game events (which would
// explode entry count) are out of scope for v1.
model PlatformLog {
  id         String   @id @default(cuid())
  platformId String
  userId     String
  level      LogLevel @default(info)
  // Machine-readable event tag, e.g. "sync.started", "sync.ok",
  // "library.imported", "trophies.applied", "achievements.applied",
  // "wishlist.imported", "token.expired", "syncFrequency.changed".
  // Used by the UI to color-code entries; humans read `message`.
  event      String
  // Human-readable terminal-style message, e.g.
  //   "library: 488 imported, 4 skipped"
  //   "trophies: 111 matched, 5 auto-completed, 0 missed"
  message    String
  // Optional structured payload for future filtering / drill-down.
  // v1 stores nothing here yet — reserved.
  details    Json?
  createdAt  DateTime @default(now())

  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@index([platformId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model Game {
  id                   String   @id @default(cuid())
  igdbId               Int      @unique
  steamAppId           Int?     @unique
  hltbId               Int?
  gogAppId             Int?
  // Xbox's per-title identifier from OpenXBL /player/titleHistory.
  // Captured during library sync (Xbox sub-unit #4.x). Used by the
  // playtime side-pass which calls POST /v2/player/stats with a batched
  // {xuids, stats: [{name: "MinutesPlayed", titleId}]} body — needs the
  // titleId to bind playtime back to the right Game. Same shape as
  // steamAppId above.
  xboxTitleId          Int?     @unique
  // PSN's stable per-title identifier. Captured during trophy sync (T2 in
  // docs/TROPHIES_PLAN.md). Lets future PSN syncs rebind by stable PSN
  // identity instead of fuzzy title-matching — partially closes the
  // "store platform-side IDs" gap from sync-quality decision #33.
  psnNpCommunicationId String?  @unique
  // Sony's "concept ID" — single identifier across all regional variants
  // of a game (multiple titleIds like PPSA20549_00, PPSA20599_00 roll up
  // to one conceptId). Captured during library sync via psn-api's
  // `concept.id` field. Maps to IGDB's external_games.uid where
  // category = 36 (Playstation Store). Used by the N-series Sony-id-first
  // resolution path in syncRunner so non-English PSN sync titles (Italian,
  // Chinese, etc.) match correctly without going through fuzzy title
  // search — same pattern as steamAppId → external_games.
  psnConceptId         Int?     @unique
  title                String
  developer            String?
  releaseYear          Int?
  genres               String[]
  coverUrl             String?
  metadata             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  userGames UserGame[]
  hltbData  HltbData?
}

model UserGame {
  id                    String     @id @default(cuid())
  userId                String
  gameId                String
  status                GameStatus @default(Backlog)
  playtimeByPlatform    Json       @default("{}")
  lastPlayedAt          DateTime?
  notes                 String?
  rating                Int?
  // Aggregate achievement / trophy progress. All four are populated by the
  // sync flow (T2 PSN trophy fetcher + T3 Steam achievement fetcher in
  // docs/TROPHIES_PLAN.md). All nullable: `null` means "no data fetched
  // yet" (pre-T2/T3 rows) OR "the game doesn't support achievements"
  // (Steam returns success=false). The receipt-block UI hides the
  // trophies / achievements line when `achievementsTotal === null`.
  achievementsEarned    Int?
  achievementsTotal     Int?
  achievementsPercent   Int?
  achievementsUpdatedAt DateTime?
  // F1-PR2 collector metadata per CONCEPTUAL_MODEL CM2 + CM12. All four
  // nullable so existing rows remain unaffected. Populated by the new
  // manual-add flow + GameDetail per-platform-wishlist affordance.
  mediaType             MediaType? // DIGITAL | PHYSICAL — sync rows leave null; manual-add sets it
  condition             Condition? // LOOSE | CIB | SEALED | REPLICA | GRADED — only meaningful when mediaType=PHYSICAL
  region                Region? // NTSC_U | NTSC_J | PAL | OTHER — only meaningful when mediaType=PHYSICAL
  // Per-platform wishlist intent per CM12. Empty by default (most users
  // wishlist generically: "I want this game" not "I want it on PC"). Per
  // CM13 it stays empty when wishlisting from the Releases-page toggle.
  // Populated only via the explicit GameDetail per-row affordance for the
  // collector use case (own GTA on PS5, also wishlist the PC version).
  // Postgres TEXT[]; mirrors Game.genres + WishlistRelease.platforms shape.
  wishlistedPlatforms   String[]   @default([])
  addedAt               DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id])

  @@unique([userId, gameId])
  @@index([userId, status])
  @@index([userId, lastPlayedAt(sort: Desc)])
}

model HltbData {
  id            String   @id @default(cuid())
  gameId        String   @unique
  mainStory     Int?
  mainExtras    Int?
  completionist Int?
  source        String   @default("hltb")
  fetchedAt     DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id])
}

// DO NOT RENAME — see docs/RELEASES_PLAN.md §1 (decision D1). The Releases
// page rename (Upcoming → Releases) is URL + UI labels only. Renaming this
// table would force a migration for a UI change. Stays `WishlistRelease`.
model WishlistRelease {
  id                  String    @id @default(cuid())
  igdbId              Int
  title               String
  developer           String?
  releaseDate         DateTime?
  releaseDateCategory String    @default("TBA")
  platforms           String[]
  genres              String[]
  userId              String
  hype                Int?
  synopsis            String?
  coverUrl            String?
  category            Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, igdbId])
  @@index([userId, releaseDate])
}

// F1 of the feedback-channel workstream (docs/FEEDBACK_PLAN.md). The L2
// layer of the user-research observation system (docs/USER_RESEARCH.md §6.2):
// in-app feedback form persisted as rows here, surfaced in /admin. No push
// channel in v1 (webhook / email-out deferred — see F-D6). Cascade-delete
// with user per F-D1: if the user is deleted, their feedback goes with
// them. Read state is a single boolean per F-D5; promotion path is adding
// `processedAt: DateTime?` (additive, no destructive change) when volume
// justifies a triage workflow.
model Feedback {
  id        String   @id @default(cuid())
  userId    String
  // Optional context auto-captured client-side at submit time. UA falls
  // back to req.headers['user-agent'] when omitted; viewport stays null
  // if the client doesn't send it (can't be inferred server-side).
  message   String
  viewport  String?
  ua        String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Primary index powers the admin chronological list. The compound
  // (read, createdAt) index powers the unread chip's COUNT(*) lookup
  // and the optional ?unreadOnly=true filter.
  @@index([createdAt(sort: Desc)])
  @@index([read, createdAt(sort: Desc)])
}

// TL1 of the telemetry workstream (docs/TELEMETRY_PLAN.md). L1 layer of
// the user-research observation system (docs/USER_RESEARCH.md §6.2):
// per-user event log surfaced via a new admin section. Promoted to active
// per D10 (no calendar chats; telemetry is the primary behavioural-gap
// instrument).
//
// Cascade-delete with user per TL-D1 (same GDPR-shaped reasoning as F-D1).
// `event` is a free-form string per TL-D4 — new event tags land without
// a migration; constraints live in code at the call site, not in the
// schema. `details` is `Json?` per TL-D5 for per-event structured payload.
// Events are immutable per TL-D10 (no `read` flag, no `processedAt`,
// no admin curation — events are facts, not triage rows).
model UserEvent {
  id        String   @id @default(cuid())
  userId    String
  event     String
  details   Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Three indexes:
  //   createdAt-desc → default chronological feed
  //   (userId, createdAt-desc) → per-user filter slice
  //   (event, createdAt-desc) → per-event-class filter (e.g. show me
  //                              every sync.first across all users)
  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([event, createdAt(sort: Desc)])
}
