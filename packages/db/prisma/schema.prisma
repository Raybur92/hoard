// Hoard — Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameStatus {
  Playing
  Backlog
  Completed
  OnHold
  Dropped
  Wishlist
}

enum PlatformCode {
  ST
  PS
  XB
  GG
  NT
  EP
}

enum SyncStatus {
  ok
  syncing
  error
  stale
  manual
}

enum SyncFrequency {
  FIVE_MIN
  FIFTEEN_MIN
  HOURLY
  MANUAL
}

enum LogLevel {
  info
  warn
  error
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  googleId  String?  @unique
  steamId   String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // preferences
  hypeThreshold  Int     @default(5)
  libraryView    String  @default("shelves")
  showHltb       Boolean @default(true)
  coverDensity   String  @default("standard")
  terminalCursor Boolean @default(true)

  platforms  Platform[]
  userGames  UserGame[]
  wishlists  WishlistRelease[]
}

model Platform {
  id            String        @id @default(cuid())
  userId        String
  code          PlatformCode
  credentials   Json?
  syncable      Boolean       @default(true)
  lastSyncAt    DateTime?
  syncStatus    SyncStatus    @default(manual)
  syncFrequency SyncFrequency @default(HOURLY)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs PlatformLog[]

  @@unique([userId, code])
}

// PR B of the settings audit workstream (`docs/SETTINGS_AUDIT_PLAN.md`).
// Per-platform activity feed: every sync touchpoint emits one or more
// log entries that the client surfaces on PlatformDetail's Log tab in
// terminal aesthetic. Aggregates only — per-game events (which would
// explode entry count) are out of scope for v1.
model PlatformLog {
  id         String   @id @default(cuid())
  platformId String
  userId     String
  level      LogLevel @default(info)
  // Machine-readable event tag, e.g. "sync.started", "sync.ok",
  // "library.imported", "trophies.applied", "achievements.applied",
  // "wishlist.imported", "token.expired", "syncFrequency.changed".
  // Used by the UI to color-code entries; humans read `message`.
  event      String
  // Human-readable terminal-style message, e.g.
  //   "library: 488 imported, 4 skipped"
  //   "trophies: 111 matched, 5 auto-completed, 0 missed"
  message    String
  // Optional structured payload for future filtering / drill-down.
  // v1 stores nothing here yet — reserved.
  details    Json?
  createdAt  DateTime @default(now())

  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)

  @@index([platformId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model Game {
  id                   String   @id @default(cuid())
  igdbId               Int      @unique
  steamAppId           Int?     @unique
  hltbId               Int?
  gogAppId             Int?
  // PSN's stable per-title identifier. Captured during trophy sync (T2 in
  // docs/TROPHIES_PLAN.md). Lets future PSN syncs rebind by stable PSN
  // identity instead of fuzzy title-matching — partially closes the
  // "store platform-side IDs" gap from sync-quality decision #33.
  psnNpCommunicationId String?  @unique
  title                String
  developer            String?
  releaseYear          Int?
  genres               String[]
  coverUrl             String?
  metadata             Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  userGames UserGame[]
  hltbData  HltbData?
}

model UserGame {
  id                    String     @id @default(cuid())
  userId                String
  gameId                String
  status                GameStatus @default(Backlog)
  playtimeByPlatform    Json       @default("{}")
  lastPlayedAt          DateTime?
  notes                 String?
  rating                Int?
  // Aggregate achievement / trophy progress. All four are populated by the
  // sync flow (T2 PSN trophy fetcher + T3 Steam achievement fetcher in
  // docs/TROPHIES_PLAN.md). All nullable: `null` means "no data fetched
  // yet" (pre-T2/T3 rows) OR "the game doesn't support achievements"
  // (Steam returns success=false). The receipt-block UI hides the
  // trophies / achievements line when `achievementsTotal === null`.
  achievementsEarned    Int?
  achievementsTotal     Int?
  achievementsPercent   Int?
  achievementsUpdatedAt DateTime?
  addedAt               DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id])

  @@unique([userId, gameId])
  @@index([userId, status])
  @@index([userId, lastPlayedAt(sort: Desc)])
}

model HltbData {
  id             String   @id @default(cuid())
  gameId         String   @unique
  mainStory      Int?
  mainExtras     Int?
  completionist  Int?
  source         String   @default("hltb")
  fetchedAt      DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id])
}

// DO NOT RENAME — see docs/RELEASES_PLAN.md §1 (decision D1). The Releases
// page rename (Upcoming → Releases) is URL + UI labels only. Renaming this
// table would force a migration for a UI change. Stays `WishlistRelease`.
model WishlistRelease {
  id                  String   @id @default(cuid())
  igdbId              Int
  title               String
  developer           String?
  releaseDate         DateTime?
  releaseDateCategory String   @default("TBA")
  platforms           String[]
  genres              String[]
  userId              String
  hype                Int?
  synopsis            String?
  coverUrl            String?
  category            Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, igdbId])
  @@index([userId, releaseDate])
}
